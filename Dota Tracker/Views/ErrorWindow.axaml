<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dota_Tracker.Views.ErrorWindow"
        Title="Error"
        Width="360" Height="180"
        WindowStartupLocation="CenterOwner"
CanResize="False">

    <StackPanel Margin="20"
                Spacing="16"
                VerticalAlignment="Center">
        <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap"></SelectableTextBlock>
        <Button HorizontalAlignment="Right" Click="OnOkClicked">Ok</Button>
    </StackPanel>

</Window>